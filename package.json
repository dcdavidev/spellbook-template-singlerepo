{
  "name": "spellbook-template-singlerepo",
  "version": "0.1.0",
  "private": false,
  "description": "Opinionated single-repo starter powered by spellbookx: zero setup, start coding right away.",
  "keywords": [
    "spellbookx",
    "template",
    "template-repository",
    "starter",
    "boilerplate",
    "typescript",
    "nodejs",
    "preconfigured",
    "developer-experience",
    "commitlint",
    "czg",
    "conventional-changelog",
    "cspell",
    "eslint",
    "prettier",
    "lefthook"
  ],
  "homepage": "https://github.com/dcdavidev/spellbookx-template-singlerepo#readme",
  "bugs": {
    "url": "https://github.com/dcdavidev/spellbookx-template-singlerepo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcdavidev/spellbookx-template-singlerepo.git"
  },
  "license": "MIT",
  "author": "Davide Di Criscito <info@dcdavidev.me>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "turbo run build lint:code lint:spelling lint:types fmt:check test",
    "commit": "czg",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "lint": "turbo run lint:code lint:spelling",
    "lint:code": "eslint --no-warn-ignored .",
    "lint:code:fix": "eslint --no-warn-ignored --fix .",
    "lint:commits": "commitlint --from=HEAD~1 --verbose",
    "lint:spelling": "cspell --no-progress --no-summary .",
    "lint:types": "tsc --noEmit",
    "prepare": "lefthook install",
    "test": "vitest run --no-fsModuleCache --passWithNoTests --coverage",
    "update:turbo": "pnpm dlx @turbo/codemod@latest update --force"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@spellbookx/recipes": "^2.0.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "commitlint-config-spellbookx": "^2.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cspell": "^10.5.2",
    "cspell-config-spellbookx": "^2.0.0",
    "cz-config-spellbookx": "^2.0.0",
    "czg": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-spellbookx": "^2.0.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-config-spellbookx": "^2.0.0",
    "turbo": "^2.11.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
